# Zkopiruj jako .env a vypln. .env nikam neposilej ani necommituj.

# Buffer: https://publish.buffer.com/settings/api -> vytvorit klic (zdarma = 3 kanaly na ucet)
# ucet 1: YouTube, X, Instagram
BUFFER_API_KEY_1=
# ucet 2: Facebook, TikTok
BUFFER_API_KEY_2=

# Cloudflare R2: bucket s verejnym pristupem (r2.dev subdomena nebo vlastni domena)
# R2 -> Manage API tokens -> Object Read & Write jen pro tento bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gta6bananaclips
# verejna adresa bucketu, napr. https://pub-xxxxxxxx.r2.dev nebo https://media.tvoje-domena.cz
MEDIA_BASE_URL=
