# Zkopiruj jako .env a vypln. .env nikam neposilej ani necommituj.
# Buffer: publish.buffer.com/settings/api (zdarma = 3 kanaly na ucet)
BUFFER_API_KEY_1=     # ucet 1: YouTube, X, Instagram
BUFFER_API_KEY_2=     # ucet 2: Facebook, TikTok, Threads
# Druhy ucet gta6fanpageclip (brands.json -> fanpage) ma vlastni 2 Buffer ucty
BUFFER_API_KEY_3=     # fanpage Buffer ucet 1 (3 kanaly)
BUFFER_API_KEY_4=     # fanpage Buffer ucet 2 (3 kanaly)
# Netlify: User settings -> Applications -> Personal access tokens
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=8e0be5b7-a90e-42a1-a58e-8a0baf8dc0da
MEDIA_BASE_URL=https://gta6bananaclips-media.netlify.app

# Twitch API (dev.twitch.tv/console/apps -> Spravovat): klipy cele kategorie GTA VI
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
